{
  "name": "ppq-private-mode",
  "version": "0.2.3",
  "type": "module",
  "description": "End-to-end encrypted AI proxy for PPQ.AI private models. Works standalone or as an OpenClaw plugin.",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "bin": {
    "ppq-private-proxy": "./dist/bin/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npx tsx bin/server.ts",
    "prepare": "tsc",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "tinfoil": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
